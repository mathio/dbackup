{
  "name": "dbackup",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22",
    "yarn": ">=1.22"
  },
  "scripts": {
    "run-node": "node --optimize_for_size --max_old_space_size=460 --gc_interval=100",
    "backup": "yarn run-node ./src/backup-all",
    "server": "yarn run-node ./src/server",
    "dev": "dotenv -- nodemon ./src/server",
    "dev-backup": "dotenv -- yarn backup",
    "test": "node --test src/**/*.test.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "express-force-https": "^1.0.0",
    "express-rate-limit": "^8.7.0",
    "handlebars": "4.7.9",
    "megajs": "^1.3.10"
  },
  "resolutions": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.7"
  }
}
